<Project>

  <PropertyGroup>
    <RootNamespace>Quartz.Spi.MongoDbJobStore</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>Full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Releases are cut by pushing a v* tag; the publish workflow passes -p:Version
       from the tag. This prefix is only the fallback for local and CI packs. -->
  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Quartz.Spi.MongoDbJobStore</Product>
    <Authors>Gabriel Lucaci</Authors>
    <Company>Gabriel Lucaci</Company>
    <Copyright>Copyright © 2021 Gabriel Lucaci</Copyright>
    <Description>MongoDB job store for Quartz.NET. Fork of glucaci/mongodb-quartz-net, published as cotique.Quartz.Spi.MongoDbJobStore.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cotique/mongodb-quartz-net</PackageProjectUrl>
    <PackageReleaseNotes>Release notes: https://github.com/cotique/mongodb-quartz-net/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/cotique/mongodb-quartz-net.git</RepositoryUrl>
    <PackageTags>Quartz.NET Store JobStore MongoDB</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>GitHub</RepositoryType>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
